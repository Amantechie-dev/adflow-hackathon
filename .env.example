# AdFlow Local Environment Secrets Template
# Copy this file, rename it to '.env', and fill in your real credentials below.

B2_BUCKET_NAME=your_backblaze_bucket_name_here
B2_KEY_ID=your_backblaze_key_id_here
B2_APPLICATION_KEY=your_backblaze_application_key_here
B2_REGION_ENDPOINT=your_backblaze_s3_endpoint_url_here

GEMINI_API_KEY=your_google_gemini_api_key_here